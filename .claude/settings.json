{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "_comment": "LLM Wiki 프로젝트 설정. hook 정의는 CLAUDE.md §1과 §6의 불변식을 강제한다.",

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/protect-raw.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/validate-frontmatter.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/log-tracker.sh"
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(grep:*)",
      "Bash(find:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sort:*)",
      "Bash(uniq:*)",
      "Bash(comm:*)",
      "Bash(sed:*)",
      "Bash(awk:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git add wiki/*)",
      "Bash(git commit:*)",
      "Bash(git mv wiki/*)"
    ],
    "deny": [
      "Bash(rm -rf raw/*)",
      "Bash(rm -rf wiki/*)",
      "Bash(git rm raw/*)",
      "Edit(raw/**)",
      "Write(raw/**)"
    ]
  }
}
